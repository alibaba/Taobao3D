---
import { getCollection, render } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Base from '../../../layouts/Base.astro';
import { useTranslations, type Lang } from '../../../i18n/ui';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => p.data.lang === 'en');
  return posts.map((post) => ({ params: { slug: post.data.slug }, props: { post } }));
}

const lang: Lang = 'en';
const { post } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(post);

const fmt = (iso: string) =>
  new Date(iso + 'T00:00:00Z').toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });
---

<Base lang={lang} path={`blog/${post.data.slug}`} title={post.data.title}>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <a
      href={getRelativeLocaleUrl(lang, 'blog')}
      class="text-sm font-medium text-brand-600 transition hover:text-brand-700"
    >
      {t.blog.back}
    </a>

    <header class="mt-6">
      <time class="text-sm font-semibold text-brand-600">{fmt(post.data.date)}</time>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        {post.data.title}
      </h1>
      {post.data.description && (
        <p class="mt-4 text-lg text-slate-600">{post.data.description}</p>
      )}
    </header>

    <div class="blog-prose mt-10">
      <Content />
    </div>
  </article>
</Base>

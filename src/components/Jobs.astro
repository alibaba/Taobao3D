---
import { getCollection } from 'astro:content';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const jobs = await getCollection('jobs');
---

<section id="jobs" class="scroll-mt-20 bg-slate-50 py-16">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">{t.jobs.heading}</h2>
    <p class="mt-3 max-w-2xl break-keep text-slate-600">{t.jobs.intro}</p>

    {/* Mobile: stacked cards (table columns squeeze the long titles too tightly). */}
    <ul class="mt-8 space-y-3 sm:hidden">
      {
        jobs.map((job) => (
          <li class="rounded-xl border border-slate-200 bg-white p-4">
            <p class="break-keep font-medium text-slate-800">
              {lang === 'zh' ? job.data.name_zh : job.data.name_en}
            </p>
            <div class="mt-3 flex items-center justify-between gap-3">
              <span
                class:list={[
                  'rounded-full px-2.5 py-1 text-xs font-semibold',
                  job.data.type === 'Full-time'
                    ? 'bg-emerald-100 text-emerald-700'
                    : 'bg-brand-100 text-brand-700',
                ]}
              >
                {job.data.type === 'Full-time' ? t.jobs.typeFulltime : t.jobs.typeIntern}
              </span>
              <a
                href={job.data.url}
                target="_blank"
                rel="noreferrer"
                class="shrink-0 font-medium text-brand-600 hover:underline"
              >
                {t.jobs.apply} →
              </a>
            </div>
          </li>
        ))
      }
    </ul>

    {/* Tablet/desktop: table. */}
    <div class="mt-8 hidden overflow-hidden rounded-xl border border-slate-200 bg-white sm:block">
      <table class="w-full text-left text-sm">
        <thead class="bg-slate-100 text-slate-600">
          <tr>
            <th class="px-5 py-3 font-semibold">{t.jobs.colPosition}</th>
            <th class="px-5 py-3 font-semibold">{t.jobs.colType}</th>
            <th class="px-5 py-3 font-semibold">{t.jobs.colLink}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {
            jobs.map((job) => (
              <tr class="transition hover:bg-slate-50">
                <td class="px-5 py-3 text-slate-800">
                  {lang === 'zh' ? job.data.name_zh : job.data.name_en}
                </td>
                <td class="px-5 py-3">
                  <span
                    class:list={[
                      'rounded-full px-2.5 py-1 text-xs font-semibold',
                      job.data.type === 'Full-time'
                        ? 'bg-emerald-100 text-emerald-700'
                        : 'bg-brand-100 text-brand-700',
                    ]}
                  >
                    {job.data.type === 'Full-time' ? t.jobs.typeFulltime : t.jobs.typeIntern}
                  </span>
                </td>
                <td class="px-5 py-3">
                  <a
                    href={job.data.url}
                    target="_blank"
                    rel="noreferrer"
                    class="font-medium text-brand-600 hover:underline"
                  >
                    {t.jobs.apply}
                  </a>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>

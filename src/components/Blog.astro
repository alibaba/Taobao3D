---
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const posts = (await getCollection('blog'))
  .filter((p) => p.data.lang === lang)
  .sort((a, b) => b.data.date.localeCompare(a.data.date));

const fmt = (iso: string) =>
  new Date(iso + 'T00:00:00Z').toLocaleDateString(lang === 'zh' ? 'zh-CN' : 'en-US', {
    year: 'numeric',
    month: lang === 'zh' ? 'long' : 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });
---

<section id="blog" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-16 sm:px-6">
  <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">{t.blog.heading}</h2>
  <p class="mt-3 max-w-2xl text-slate-600">{t.blog.intro}</p>

  {
    posts.length === 0 ? (
      <p class="mt-10 text-slate-500">{t.blog.empty}</p>
    ) : (
      <div class="mt-10 grid gap-5 sm:grid-cols-2">
        {posts.map((post) => (
          <a
            href={getRelativeLocaleUrl(lang, `blog/${post.data.slug}`)}
            class="group flex flex-col rounded-xl border border-slate-200 bg-white p-6 transition hover:border-brand-500/50 hover:shadow-sm"
          >
            <time class="text-sm font-semibold text-brand-600">{fmt(post.data.date)}</time>
            <h3 class="mt-2 font-semibold leading-snug text-slate-900 group-hover:text-brand-700">
              {post.data.title}
            </h3>
            {post.data.description && (
              <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">
                {post.data.description}
              </p>
            )}
            <span class="mt-4 text-sm font-medium text-brand-600">{t.blog.readMore}</span>
          </a>
        ))}
      </div>
    )
  }
</section>

---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Route segment of the current page ('' for home, e.g. 'about'). */
  path?: string;
  /** Optional page title prefix (e.g. a blog post title). */
  title?: string;
}

const { lang, path = '', title: pageTitle } = Astro.props;
const t = useTranslations(lang);

const siteName = `${t.brand} · ${t.teamName}`;
const title = pageTitle ? `${pageTitle} · ${t.brand}` : siteName;
const description =
  lang === 'zh'
    ? '淘天技术团队 —— 推动 3D 与 XR 技术：物体与人体重建、端侧 3D 引擎。'
    : 'TaoTian Technology Team — advancing 3D and XR technologies: object & human reconstruction, and an on-device 3D engine.';

const base = import.meta.env.BASE_URL;
const asset = (p: string) => `${base}/${p}`.replace(/\/+/g, '/');
const social = asset('overview.png');

// The home page opens with a fullscreen hero video; the header reveals on scroll.
const isHome = path === '';
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(social, Astro.site ?? Astro.url)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <Header lang={lang} path={path} reveal={isHome} />
    <main class:list={[!isHome && 'pt-16']}>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

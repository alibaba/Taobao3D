# Public repo: always install from the public npm registry so CI and external
# contributors don't depend on an internal mirror.
# `replace-registry-host=always` rewrites the host of any `resolved` URL in
# package-lock.json to the registry below at install time, so `npm ci` works
# even though the lockfile was generated against an internal mirror.
registry=https://registry.npmjs.org/
replace-registry-host=always
